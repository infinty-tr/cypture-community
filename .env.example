# ── Server ──
CYPTURE_HOST=127.0.0.1
CYPTURE_PORT=7777
# "dev" or "prod". prod enables Secure cookies + HSTS.
CYPTURE_ENV=dev
# Public base URL used to build invite links (e-mail).
CYPTURE_BASE_URL=http://127.0.0.1:7777

# ── Security ──
# 32+ byte random secret for signed cookies / CSRF. REQUIRED in prod.
# Generate: openssl rand -hex 32
CYPTURE_SESSION_SECRET=

# ── Seed admin (created on first boot if no admin exists) ──
ADMIN_EMAIL=admin@cypture.local
ADMIN_PASSWORD=change-me-please

# ── Storage (SQLite via GORM) ──
CYPTURE_DB_PATH=./data/cypture.db

# ── Agent / tooling ──
# Working directory of the autonomous agent system (the knowledge base given to cypture-agent).
CYPTURE_AGENT_DIR=./agent

# Orchestrator runner:
#   sim           → scripted demo, no external calls (safe default; NOT a real scan)
#   live          → run the agent runtime as a local process in ./agent (real scan,
#                   single-operator). This is the SUPPORTED real-scan path for the
#                   Community Edition. Requires CYPTURE_AGENT_BIN + a valid
#                   CYPTURE_RUNNER_MODEL and the cypture-engine binary on PATH.
#                   ('cypture-agent' and 'real' are accepted aliases of 'live'.)
#   docker / k8s  → ISOLATED container / Pod per engagement. ADVANCED: the shipped
#                   engine image expects a scan-brain binary that is NOT included in
#                   the CE repo (see README) — bring your own, or use 'live'.
CYPTURE_RUNNER=sim
# Path/name of the agent-runtime binary (the LLM agent executor). Must be on PATH or absolute.
# The CE supports opencode (https://opencode.ai) as the runtime: install opencode, then
# point this at the adapter shim in scripts/opencode-shim (copy it to a stable location):
#   CYPTURE_AGENT_BIN=/opt/cypture/bin/opencode-shim
# If opencode is not on the service PATH, set OPENCODE_BIN to its absolute path.
CYPTURE_AGENT_BIN=cypture-agent
# OPENCODE_BIN=/home/you/.local/bin/opencode
# Feed/IPC directory for the live runner. Empty = the per-scan WorkDir under
# CYPTURE_AGENT_DIR/targets (recommended; user-writable). The container runners use /cyp.
# CYP_FEED_DIR=
# Allow scanning internal/localhost/private targets (your own apps). OFF by default
# (reaching internal/metadata ranges is an SSRF risk on shared deployments). Turn ON only
# on a single-operator self-host where scanning your own internal targets is intended.
# CYPTURE_ALLOW_INTERNAL_TARGETS=false
# Default engine model + optional overrides. Set to whatever your provider supports.
# CYPTURE_RUNNER_MODEL=openai/gpt-4o-mini
# CYPTURE_RUNNER_AGENT=
# Reasoning-heavy experts (web/api/reporter) run on this; recon/fuzz stay on the base
# model. Empty = all experts use the base model. MUST share the base model's provider
# prefix (one auth.json authenticates both).
# CYPTURE_REASONING_MODEL=
# Skip agent permission prompts. MUST be false in prod (the boot-time Validate() rejects
# true when CYPTURE_ENV=prod).
CYPTURE_RUNNER_SKIP_PERMS=false
# Hard wall-clock budget per scan in seconds (cost guardrail; 0 = unlimited).
CYPTURE_BUDGET_SECONDS=0
# Scan retention in days: after this window a finished scan's WorkDir + live event/
# traffic rows are purged; the scan summary + findings + archived report are KEPT.
# 0 disables the janitor.
CYPTURE_SCAN_RETENTION_DAYS=30

# ── Docker-per-engagement runner (CYPTURE_RUNNER=docker) ──
# Build the image first:  make docker-image
CYPTURE_DOCKER_IMAGE=cypture-engine:latest
# Empty = default bridge (internet egress, NO published ports → not reachable externally).
CYPTURE_DOCKER_NETWORK=
CYPTURE_DOCKER_MEMORY=2g
CYPTURE_DOCKER_CPUS=2
# Credentials mounted read-only into each container:
CYPTURE_AGENT_AUTH_DIR=~/.local/share/cypture-agent
CYPTURE_ENGINE_TOKEN=~/.cypture-mcp/token.json

# ── Cypture (only relevant for the local 'cypture-agent' runner) ──
CYPTURE_ENGINE_URL=http://localhost:8080
CYPTURE_ENGINE_BIN=cypture-engine

# ── LLM provider key (turnkey) ──────────────────────────────────────────────
# If set, each engine container authenticates cypture-agent with THIS key (nothing is
# mounted from the host). Provider is derived from CYPTURE_RUNNER_MODEL's prefix
# unless CYPTURE_LLM_PROVIDER is set. Leave empty to fall back to the host auth.json
# (only mounted into containers when CYP_ALLOW_SHARED_AUTH_JSON=1 — see below).
CYPTURE_LLM_API_KEY=
CYPTURE_LLM_PROVIDER=

# ── Kubernetes runner (CYPTURE_RUNNER=k8s) ──────────────────────────────────
# Per-scan Pod on a (single-node) k3s cluster. Reuses the DOCKER_* image/mem/cpu.
CYPTURE_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
CYPTURE_K8S_NAMESPACE=default
CYPTURE_KUBECTL_BIN=kubectl
# Import the engine image into k3s containerd after building it:
#   docker save cypture-engine:latest | sudo k3s ctr images import -

# ── Concurrency guards ──────────────────────────────────────────────────────
CYPTURE_MAX_CONCURRENT_SCANS=3
CYPTURE_GLOBAL_MAX_CONCURRENT_SCANS=6

# ── Cost metering (display only) ────────────────────────────────────────────
# The community edition does not bill. Token cost is still recorded per scan for
# visibility; this markup multiplier only affects the displayed figure.
CYPTURE_PRICE_MARKUP=1.0

# ── API rate limiting (per client IP) ───────────────────────────────────────
CYPTURE_RATE_LIMIT_PER_MIN=240
CYPTURE_RATE_LIMIT_BURST=60

# ── Email verification (SMTP) ───────────────────────────────────────────────
# Empty host ⇒ verification DISABLED: invited accounts are active
# immediately without proving email ownership, and invite mails are only logged
# (stub), not delivered. Set these in prod to actually send verification/invite mail.
CYPTURE_SMTP_HOST=
CYPTURE_SMTP_PORT=587
CYPTURE_SMTP_USER=
CYPTURE_SMTP_PASS=
CYPTURE_SMTP_FROM=

# ── Engine tuning (CYP_*) — passed through to the scan container ─────────────
# Empty = the script-embedded default inside the image is used.
# CYP_DEEPEN_ROUNDS=
# CYP_DEEPEN_HOSTS_PER_ROUND=4
# CYP_MAX_PARALLEL=4
# CYP_REAPER_STALL_TTL=900
# CYP_AGENT_WAIT_MAX=1500
# CYP_USE_MODEL_ORCH=0
# CYP_DETERMINISTIC=
# CYP_NUCLEI_AUTO=0
# SECURITY: mount the SHARED host auth.json into tenant containers. Leave UNSET/0 —
# a target that RCEs the engine could exfiltrate the shared key. Only set to 1 if you
# accept that risk and are not using a per-scan CYPTURE_LLM_API_KEY.
# CYP_ALLOW_SHARED_AUTH_JSON=0
