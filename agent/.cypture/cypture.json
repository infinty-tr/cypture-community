{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cyp": {
      "type": "local",
      "command": [
        "cypture-engine",
        "serve"
      ],
      "environment": {
        "CYPTURE_ENGINE_URL": "http://localhost:8080"
      },
      "enabled": true
    }
  },
  "tools": {
    "webfetch": false
  },
  "permission": {
    "webfetch": "deny",
    "bash": {
      "git *": "deny",
      "git clone*": "deny",
      "curl *github*": "deny",
      "curl *githubusercontent*": "deny",
      "curl *gitlab*": "deny",
      "wget *github*": "deny",
      "*": "allow"
    }
  }
}
